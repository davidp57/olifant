     xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd">
  <metadata><name>Chambiere et le plan d'eau</name><desc>4.5 km. D+ 19 m. 34 % de chemins. La meme eau par l'autre bout : on longe la rive ouest du plan d'eau, on passe sur la rive nord -- celle que personne ne prend -- et on rentre par l'abbaye Saint-Vincent et l'ile.</desc></metadata>
  <wpt lat="49.1153870" lon="6.1768700"><name>Rue des Parmentiers, Metz</name><desc>Depart des deux boucles vers Borny, dans la Nouvelle Ville. A dix minutes a pied de la gare, dont il partage les commodites.</desc></wpt>
  <wpt lat="49.1159680" lon="6.1705190"><name>Jardin de l'Esplanade</name><desc>Terrasse au-dessus de la Moselle, vue sur le Mont Saint-Quentin.</desc></wpt>
  <wpt lat="49.1161600" lon="6.1673270"><name>Parc du Lac aux Cygnes</name><desc>Rive du plan d'eau sous l'Esplanade, cygnes et saules.</desc></wpt>
  <wpt lat="49.1158530" lon="6.1631070"><name>Base de loisirs de l'Esplanade</name><desc>Rive ouest du plan d'eau, face au Saulcy. Buvette l'ete.</desc></wpt>
  <wpt lat="49.1192000" lon="6.1644000"><name>Plan d'eau, rive nord</name><desc>La rive d'en face, celle que personne ne prend. Plus calme, plus ombragee.</desc></wpt>
  <wpt lat="49.1231340" lon="6.1724500"><name>Abbaye Saint-Vincent</name><desc>Ancienne abbaye du quartier Chambiere, facade classique.</desc></wpt>
  <wpt lat="49.1197430" lon="6.1703820"><name>Temple Neuf et le Moyen Pont</name><desc>Pointe de l'ile du Petit-Saulcy, entre les deux bras de la Moselle ; la vue sur la cathedrale et le plan d'eau.</desc></wpt>
