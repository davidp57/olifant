     xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd">
  <metadata><name>La boucle de la Seille</name><desc>4.2 km. D+ 5 m. 34 % de chemins. Le tour complet de la riviere en ville : le jardin des Cinq Sens, l'Amphitheatre, les jardins Pelt, le parc de la Seille, et la remontee jusqu'a la Porte des Allemands. Quatre-vingts metres refaits, pas un de plus.</desc></metadata>
  <wpt lat="49.1153870" lon="6.1768700"><name>Rue des Parmentiers, Metz</name><desc>Depart des deux boucles vers Borny, dans la Nouvelle Ville. A dix minutes a pied de la gare, dont il partage les commodites.</desc></wpt>
  <wpt lat="49.1125690" lon="6.1808580"><name>Jardin des Cinq Sens</name><desc>Jardin au bord de la Seille, au pied d'Outre-Seille.</desc></wpt>
  <wpt lat="49.1086850" lon="6.1796580"><name>Parvis de l'Amphitheatre</name><desc>Le quartier neuf derriere la gare, Centre Pompidou et esplanade.</desc></wpt>
  <wpt lat="49.1087550" lon="6.1809620"><name>Jardin Jean-Baptiste Keune</name><desc>Jardin du Sablon nord, a deux pas de la Seille.</desc></wpt>
  <wpt lat="49.1065930" lon="6.1857570"><name>Jardins Jean-Marie Pelt</name><desc>Prolongement sud du parc de la Seille, prairies et passerelles.</desc></wpt>
  <wpt lat="49.1066100" lon="6.1849680"><name>Parc de la Seille</name><desc>Prairies humides et roselieres au bord de la Seille. Herons.</desc></wpt>
  <wpt lat="49.1178800" lon="6.1855680"><name>Porte des Allemands</name><desc>Chatelet fortifie du XIIIe siecle a cheval sur la Seille, et le depart du chemin des remparts.</desc></wpt>
