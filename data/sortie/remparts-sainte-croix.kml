<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2"><Document>
  <name>Les remparts et la colline Sainte-Croix</name><description>4.2 km. D+ 29 m. 16 % de chemins. La plus courte : le chemin des remparts depuis la Porte des Allemands, les terrasses du jardin des Tanneurs, Chambiere et l'ile. Une heure, et tout le vieux Metz.</description>
  <Style id="depart"><IconStyle><scale>1.2</scale><Icon><href>http://maps.google.com/mapfiles/kml/paddle/grn-circle.png</href></Icon></IconStyle></Style>
  <Style id="etape"><IconStyle><Icon><href>http://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style>
    <Placemark><name>Depart : Rue des Parmentiers, Metz</name><description>Depart des deux boucles vers Borny, dans la Nouvelle Ville. A dix minutes a pied de la gare, dont il partage les commodites.</description><styleUrl>#depart</styleUrl><Point><coordinates>6.1768700,49.1153870,0</coordinates></Point></Placemark>
    <Placemark><name>1. Porte des Allemands</name><description>Chatelet fortifie du XIIIe siecle a cheval sur la Seille, et le depart du chemin des remparts.</description><styleUrl>#etape</styleUrl><Point><coordinates>6.1855680,49.1178800,0</coordinates></Point></Placemark>
    <Placemark><name>2. Jardin des Tanneurs</name><description>Jardin en terrasses sur le flanc de la colline Sainte-Croix.</description><styleUrl>#etape</styleUrl><Point><coordinates>6.1811210,49.1197080,0</coordinates></Point></Placemark>
    <Placemark><name>3. Moulin des Thermes</name><description>Bras de la Moselle a Chambiere, ancien moulin et lavoirs.</description><styleUrl>#etape</styleUrl><Point><coordinates>6.1765620,49.1230520,0</coordinates></Point></Placemark>
    <Placemark><name>4. Abbaye Saint-Vincent</name><description>Ancienne abbaye du quartier Chambiere, facade classique.</description><styleUrl>#etape</styleUrl><Point><coordinates>6.1724500,49.1231340,0</coordinates></Point></Placemark>
    <Placemark><name>5. Temple Neuf et le Moyen Pont</name><description>Pointe de l'ile du Petit-Saulcy, entre les deux bras de la Moselle ; la vue sur la cathedrale et le plan d'eau.</description><styleUrl>#etape</styleUrl><Point><coordinates>6.1703820,49.1197430,0</coordinates></Point></Placemark>
    <Placemark><name>6. Jardin de l'Esplanade</name><description>Terrasse au-dessus de la Moselle, vue sur le Mont Saint-Quentin.</description><styleUrl>#etape</styleUrl><Point><coordinates>6.1705190,49.1159680,0</coordinates></Point></Placemark>
    <Style id="t1"><LineStyle><color>ff8E5572</color><width>4</width></LineStyle></Style>
