     xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd">
  <metadata><name>Le tour du Sablon</name><desc>5.1 km. D+ 8 m. 27 % de chemins. Plein sud derriere la gare, la traversee du Sablon jusqu'a son square central, le retour par le jardin Keune et le quartier de l'Amphitheatre. Plate de bout en bout, et la moins bitumee du lot avec la Cheneau.</desc></metadata>
  <wpt lat="49.1153870" lon="6.1768700"><name>Rue des Parmentiers, Metz</name><desc>Depart des deux boucles vers Borny, dans la Nouvelle Ville. A dix minutes a pied de la gare, dont il partage les commodites.</desc></wpt>
  <wpt lat="49.1092770" lon="6.1770130"><name>Gare de Metz, parvis</name><desc>Point de ralliement des boucles a pied : a moins d'un quart d'heure de marche pour tout le monde. Abrite, cafe ouvert tot, toilettes.</desc></wpt>
  <wpt lat="49.1078690" lon="6.1696860"><name>Place Jean Moulin</name><desc>Entre la gare et le Sablon, sous les platanes.</desc></wpt>
  <wpt lat="49.1007230" lon="6.1783190"><name>Square Loiseau de Persuis, Sablon</name><desc>Coeur du Sablon, a mi-chemin entre la gare et les roselieres.</desc></wpt>
  <wpt lat="49.1087550" lon="6.1809620"><name>Jardin Jean-Baptiste Keune</name><desc>Jardin du Sablon nord, a deux pas de la Seille.</desc></wpt>
  <wpt lat="49.1086850" lon="6.1796580"><name>Parvis de l'Amphitheatre</name><desc>Le quartier neuf derriere la gare, Centre Pompidou et esplanade.</desc></wpt>
