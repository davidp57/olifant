<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2"><Document>
  <name>Le Sansonnet et les portes</name><description>5.1 km. D+ 42 m. 27 % de chemins. La plus verte des courtes cote nord : le bras de la Moselle a Chambiere, les sous-bois du parc du Sansonnet, puis les deux portes fortifiees, Sarrelouis et les Allemands. Un tiers de chemin balise.</description>
  <Style id="depart"><IconStyle><scale>1.2</scale><Icon><href>http://maps.google.com/mapfiles/kml/paddle/grn-circle.png</href></Icon></IconStyle></Style>
  <Style id="etape"><IconStyle><Icon><href>http://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style>
    <Placemark><name>Depart : Rue des Parmentiers, Metz</name><description>Depart des deux boucles vers Borny, dans la Nouvelle Ville. A dix minutes a pied de la gare, dont il partage les commodites.</description><styleUrl>#depart</styleUrl><Point><coordinates>6.1768700,49.1153870,0</coordinates></Point></Placemark>
    <Placemark><name>1. Moulin des Thermes</name><description>Bras de la Moselle a Chambiere, ancien moulin et lavoirs.</description><styleUrl>#etape</styleUrl><Point><coordinates>6.1765620,49.1230520,0</coordinates></Point></Placemark>
    <Placemark><name>2. Parc du Sansonnet, entree sud</name><description>Le plus grand espace vert du nord de Metz, etang et sous-bois.</description><styleUrl>#etape</styleUrl><Point><coordinates>6.1880000,49.1260000,0</coordinates></Point></Placemark>
    <Placemark><name>3. Porte de Sarrelouis</name><description>Vestige des fortifications du XVIIIe siecle, a l'est de la ville.</description><styleUrl>#etape</styleUrl><Point><coordinates>6.1914470,49.1206290,0</coordinates></Point></Placemark>
    <Placemark><name>4. Porte des Allemands</name><description>Chatelet fortifie du XIIIe siecle a cheval sur la Seille, et le depart du chemin des remparts.</description><styleUrl>#etape</styleUrl><Point><coordinates>6.1855680,49.1178800,0</coordinates></Point></Placemark>
    <Style id="t1"><LineStyle><color>ff6E8B3D</color><width>4</width></LineStyle></Style>
