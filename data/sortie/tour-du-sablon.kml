<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2"><Document>
  <name>Le tour du Sablon</name><description>5.1 km. D+ 8 m. 27 % de chemins. Plein sud derriere la gare, la traversee du Sablon jusqu'a son square central, le retour par le jardin Keune et le quartier de l'Amphitheatre. Plate de bout en bout, et la moins bitumee du lot avec la Cheneau.</description>
  <Style id="depart"><IconStyle><scale>1.2</scale><Icon><href>http://maps.google.com/mapfiles/kml/paddle/grn-circle.png</href></Icon></IconStyle></Style>
  <Style id="etape"><IconStyle><Icon><href>http://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style>
    <Placemark><name>Depart : Rue des Parmentiers, Metz</name><description>Depart des deux boucles vers Borny, dans la Nouvelle Ville. A dix minutes a pied de la gare, dont il partage les commodites.</description><styleUrl>#depart</styleUrl><Point><coordinates>6.1768700,49.1153870,0</coordinates></Point></Placemark>
    <Placemark><name>1. Gare de Metz, parvis</name><description>Point de ralliement des boucles a pied : a moins d'un quart d'heure de marche pour tout le monde. Abrite, cafe ouvert tot, toilettes.</description><styleUrl>#etape</styleUrl><Point><coordinates>6.1770130,49.1092770,0</coordinates></Point></Placemark>
    <Placemark><name>2. Place Jean Moulin</name><description>Entre la gare et le Sablon, sous les platanes.</description><styleUrl>#etape</styleUrl><Point><coordinates>6.1696860,49.1078690,0</coordinates></Point></Placemark>
    <Placemark><name>3. Square Loiseau de Persuis, Sablon</name><description>Coeur du Sablon, a mi-chemin entre la gare et les roselieres.</description><styleUrl>#etape</styleUrl><Point><coordinates>6.1783190,49.1007230,0</coordinates></Point></Placemark>
    <Placemark><name>4. Jardin Jean-Baptiste Keune</name><description>Jardin du Sablon nord, a deux pas de la Seille.</description><styleUrl>#etape</styleUrl><Point><coordinates>6.1809620,49.1087550,0</coordinates></Point></Placemark>
    <Placemark><name>5. Parvis de l'Amphitheatre</name><description>Le quartier neuf derriere la gare, Centre Pompidou et esplanade.</description><styleUrl>#etape</styleUrl><Point><coordinates>6.1796580,49.1086850,0</coordinates></Point></Placemark>
    <Style id="t1"><LineStyle><color>ff5D5FA6</color><width>4</width></LineStyle></Style>
