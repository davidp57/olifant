<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2"><Document>
  <name>Saint-Julien et Grimont, depuis la rue des Parmentiers</name><description>12.3 km. D+ 164 m. 27 % de chemins. La meme boucle prise de chez soi : un kilometre de moins, et plus rien en double.</description>
  <Style id="depart"><IconStyle><scale>1.2</scale><Icon><href>http://maps.google.com/mapfiles/kml/paddle/grn-circle.png</href></Icon></IconStyle></Style>
  <Style id="etape"><IconStyle><Icon><href>http://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style>
    <Placemark><name>Depart : Rue des Parmentiers, Metz</name><description>Depart des deux boucles vers Borny, dans la Nouvelle Ville. A dix minutes a pied de la gare, dont il partage les commodites.</description><styleUrl>#depart</styleUrl><Point><coordinates>6.1768700,49.1153870,0</coordinates></Point></Placemark>
    <Placemark><name>1. Parc Marie et Mathias</name><description>Petit parc au pied de la cote de Saint-Julien.</description><styleUrl>#etape</styleUrl><Point><coordinates>6.1960500,49.1303700,0</coordinates></Point></Placemark>
    <Placemark><name>2. Fort de Saint-Julien, lisiere</name><description>Le chemin qui longe le fort par le nord. Le point est pose sur le chemin plutot que dans le fort : y entrer obligeait a revenir sur ses pas.</description><styleUrl>#etape</styleUrl><Point><coordinates>6.2072000,49.1415000,0</coordinates></Point></Placemark>
    <Placemark><name>3. Bois de Grimont</name><description>Le hameau de Grimont, a la sortie du bois.</description><styleUrl>#etape</styleUrl><Point><coordinates>6.2191000,49.1434200,0</coordinates></Point></Placemark>
    <Placemark><name>4. Espace naturel pedagogique, Saint-Julien</name><description></description><styleUrl>#etape</styleUrl><Point><coordinates>6.2150700,49.1315900,0</coordinates></Point></Placemark>
    <Placemark><name>5. Parc Marthe Cohn</name><description></description><styleUrl>#etape</styleUrl><Point><coordinates>6.2089100,49.1234900,0</coordinates></Point></Placemark>
    <Style id="t1"><LineStyle><color>ffB5654F</color><width>4</width></LineStyle></Style>
