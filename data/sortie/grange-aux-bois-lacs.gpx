  <metadata><name>Grange-aux-Bois et les lacs du Technopole</name><desc>14.1 km. D+ 117 m. 33 % de chemins. Par Plantieres et le fort de Queuleu, puis la ceinture verte jusqu'a Grange-aux-Bois, la Roseraie et le lac Ariane ; retour par le Technopole et le lac Symphonie. Le premier kilometre se fait a l'aller et au retour.</desc></metadata>
  <wpt lat="49.1084000" lon="6.1811000"><name>Centre Pompidou-Metz, parvis</name><desc>Point de rendez-vous, sur le parvis des Droits de l'Homme, a deux pas de la gare.</desc></wpt>
  <wpt lat="49.1035600" lon="6.1968500"><name>Square Pierre Simon, Plantieres</name></wpt>
  <wpt lat="49.0984520" lon="6.1954340"><name>Fort de Queuleu</name><desc>Fort du XIXe siecle, memorial de la Resistance. Le bois autour est ouvert et sillonne de chemins.</desc></wpt>
  <wpt lat="49.0959600" lon="6.2169300"><name>Parc du Vallon</name></wpt>
  <wpt lat="49.0955500" lon="6.2357300"><name>Lac Ariane</name></wpt>
  <wpt lat="49.0957900" lon="6.2429100"><name>Parc de la Roseraie, Grange-aux-Bois</name></wpt>
  <wpt lat="49.1035200" lon="6.2171100"><name>Lac Symphonie</name></wpt>
  <wpt lat="49.1114980" lon="6.2021930"><name>Technopole, square Simon-Louis Freres</name><desc>Allees plantees du Technopole, autour du plan d'eau Symphonie.</desc></wpt>
