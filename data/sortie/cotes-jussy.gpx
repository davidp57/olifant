<gpx version="1.1" creator="olifant"
     xmlns="http://www.topografix.com/GPX/1/1"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd">
  <metadata><name>Les cotes de Jussy</name><desc>15.2 km. D+ 341 m. 50 % de chemins. Depart : Sainte-Ruffine, centre du village (15 min de Metz). Le versant ouest de la cote, vignes en bas et hetraie en haut, jusqu'au sommet du Saint-Quentin ; retour en balcon par Lessy et Rozerieulles.</desc></metadata>
  <wpt lat="49.1057750" lon="6.0963210"><name>Sainte-Ruffine</name><desc>Petit village accroche a la cote, depart des sentiers du versant ouest.</desc></wpt>
  <wpt lat="49.1019750" lon="6.0860600"><name>Jussy</name><desc>Village vigneron, vue sur la vallee depuis les hauts.</desc></wpt>
  <wpt lat="49.0941090" lon="6.0807540"><name>Vaux</name><desc>Fond de vallon boise, source et lavoir.</desc></wpt>
  <wpt lat="49.1110920" lon="6.1113370"><name>Eglise fortifiee Saint-Quentin, Scy-Chazelles</name><desc>Eglise fortifiee du XIIe siecle, tombe de Robert Schuman a l'interieur, sa maison a 200 m. C'est ici que commence la montee.</desc></wpt>
  <wpt lat="49.1212250" lon="6.1273020"><name>Mont Saint-Quentin, sommet</name><desc>358 m, ancien complexe fortifie en partie ruine, bois et prairies, panorama sur toute la vallee. Les batiments sont interdits d'acces.</desc></wpt>
  <wpt lat="49.1201680" lon="6.0955820"><name>Lessy</name><desc>Village blotti dans le cirque, au pied du versant sud du Saint-Quentin.</desc></wpt>
  <wpt lat="49.1072140" lon="6.0827150"><name>Rozerieulles</name><desc>Village vigneron sur le versant, en balcon au-dessus de la Moselle.</desc></wpt>
  <trk><name>Les cotes de Jussy</name><trkseg>
