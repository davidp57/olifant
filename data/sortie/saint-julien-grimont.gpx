     xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd">
  <metadata><name>Les hauts de Saint-Julien et le bois de Grimont</name><desc>13.4 km. D+ 193 m. 41 % de chemins. La seule boucle a pied qui monte vraiment : on grimpe la cote de Saint-Julien par le parc Marie et Mathias, on longe le fort, on traverse le bois de Grimont, et on redescend par Saint-Julien et le parc Marthe Cohn. Le premier kilometre et demi, jusqu'a Bellecroix, se fait a l'aller et au retour.</desc></metadata>
  <wpt lat="49.1084000" lon="6.1811000"><name>Centre Pompidou-Metz, parvis</name><desc>Point de rendez-vous, sur le parvis des Droits de l'Homme, a deux pas de la gare.</desc></wpt>
  <wpt lat="49.1303700" lon="6.1960500"><name>Parc Marie et Mathias</name><desc>Au pied de la cote de Saint-Julien.</desc></wpt>
  <wpt lat="49.1415000" lon="6.2072000"><name>Fort de Saint-Julien, lisiere</name><desc>Le chemin qui longe le fort par le nord. Le point est pose sur le chemin plutot que dans le fort : y entrer obligeait a revenir sur ses pas.</desc></wpt>
  <wpt lat="49.1434240" lon="6.2190990"><name>Bois de Grimont</name><desc>Bois de coteau au nord-est, vue sur la vallee de la Moselle.</desc></wpt>
  <wpt lat="49.1315900" lon="6.2150700"><name>Espace naturel pedagogique, Saint-Julien</name></wpt>
  <wpt lat="49.1234900" lon="6.2089100"><name>Parc Marthe Cohn</name></wpt>
  <trk><name>Les hauts de Saint-Julien et le bois de Grimont</name><trkseg>
